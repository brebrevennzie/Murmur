rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /cabinets/{cabinetId} {
      allow get, write: if true;
      allow list: if request.auth != null && resource.data.tutorId == request.auth.uid;
    }
    match /test_templates/{templateId} {
      allow read, delete: if request.auth != null && resource.data.tutorId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.tutorId == request.auth.uid;
    }
  }
}
